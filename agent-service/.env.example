# OpenLux console: https://www.openlux.ai/console/token
# Use a model available to your account that supports function/tool calling.
OPENAI_BASE_URL=https://api.openlux.ai/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Luna Chat Completions function calling requires none.
OPENAI_REASONING_EFFORT=none
LOCALPERKS_BASE_URL=http://127.0.0.1:8081
REDIS_URL=redis://127.0.0.1:6379/0

LOCALPERKS_TIMEZONE=Asia/Shanghai
AGENT_ORCHESTRATION=supervisor
# Reliable task/checkpoint/event/action/usage store. No SQLite runtime fallback.
# If omitted, AGENT_STATE_DSN uses PGVECTOR_DSN from .env.platform.
# AGENT_STATE_DSN=postgresql://agent:YOUR_PASSWORD@127.0.0.1:5433/agent_knowledge
AGENT_STATE_SCHEMA=agent_state
# Run python -m api.bootstrap to create a separate .env.platform for PostgreSQL.
# PGVECTOR_DSN=postgresql://agent:YOUR_PASSWORD@127.0.0.1:5433/agent_knowledge
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_PATH=/rerank
ALLOW_MOCK_PAY=false
AGENT_OPS_ENABLED=false

# Shared by every replica. Generate with python -m api.bootstrap; keep it secret.
AGENT_CREDENTIAL_KEY=
AGENT_WORKERS=16
AGENT_GLOBAL_WORKFLOWS=256
AGENT_QUEUE_CAPACITY=10000
AGENT_PER_USER_PENDING=32
AGENT_QUEUE_WAIT_SECONDS=300
AGENT_CREDENTIAL_TTL=900
AGENT_REDIS_CONNECTIONS=64
AGENT_REDIS_POOL_WAIT=10
# Set these to the actual account/model allowance. They are application budgets.
AGENT_QUOTA_SCOPE=primary
AGENT_MODEL_RPM=6000
AGENT_MODEL_TPM=6000000
AGENT_MODEL_CONCURRENCY=128
AGENT_MODEL_OUTPUT_TOKENS=2048
AGENT_MODEL_QUOTA_WAIT=2
AGENT_MODEL_CALL_TIMEOUT=45
